# 生产环境请至少覆盖 SECRET_KEY 与数据目录
SECRET_KEY=change-me-in-production-use-32-bytes-or-more
ACCESS_TOKEN_EXPIRE_MINUTES=720
FREE_DAILY_QUOTA=20
ANONYMOUS_DAILY_QUOTA=5

# 数据目录（SQLite 文件所在位置）
# SEMIREL_DATA_DIR=/var/lib/semirel

# 也可直接指定完整的数据库连接串（如 PostgreSQL）
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/semirel
